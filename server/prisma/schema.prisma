// Prisma schema for the Movies app backend.
// Uses SQLite for zero-config local/dev setup. Swap the datasource provider
// to "postgresql" and set DATABASE_URL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  lists           MovieList[]
  ratings         Rating[]
  comments        Comment[]
  recommendations Recommendation[]
  recVotes        RecommendationVote[]
  recComments     RecommendationComment[]
}

// A user-created collection of titles (movies/series) gathered from different platforms.
model MovieList {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean  @default(false)
  // Short opaque id used for public sharing links.
  shareId     String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ListItem[]

  @@index([userId])
}

// A single title saved inside a list. We cache a little TMDB metadata so the
// list renders without an extra round-trip per item.
model ListItem {
  id         String   @id @default(cuid())
  tmdbId     Int
  mediaType  String // "movie" | "tv"
  title      String
  posterPath String?
  note       String?
  // Manual rank within the list (0-based). Lower = higher up the chart.
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  listId String
  list   MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId, mediaType])
  @@index([listId])
}

// A star rating a user gives to a title. One rating per user per title.
model Rating {
  id        String   @id @default(cuid())
  tmdbId    Int
  mediaType String // "movie" | "tv"
  stars     Int // 1..5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId, mediaType])
}

// A free-text review/comment a user leaves on a title.
model Comment {
  id        String   @id @default(cuid())
  tmdbId    Int
  mediaType String // "movie" | "tv"
  body      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbId, mediaType])
}

// A user's recommendation of a title ("فيلم السهرة") that appears in the
// community recommendations feed. Others can up/down vote and comment on it.
model Recommendation {
  id         String   @id @default(cuid())
  tmdbId     Int
  mediaType  String // "movie" | "tv"
  title      String
  posterPath String?
  // Optional "why I recommend it" note from the recommender.
  note       String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes    RecommendationVote[]
  comments RecommendationComment[]

  // One recommendation per user per title (re-recommending just updates the note).
  @@unique([userId, tmdbId, mediaType])
  @@index([createdAt])
}

// A like (+1) or dislike (-1) on a recommendation. One vote per user.
model RecommendationVote {
  id    String @id @default(cuid())
  value Int // 1 = like, -1 = dislike

  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
  @@index([recommendationId])
}

// A comment on a recommendation in the feed.
model RecommendationComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}
