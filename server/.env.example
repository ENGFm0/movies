# Server port
PORT=4000

# JWT secret for signing auth tokens — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Prisma / SQLite database location
DATABASE_URL="file:./dev.db"

# TMDB (https://www.themoviedb.org/settings/api)
# Use a v4 "API Read Access Token" (recommended) OR a v3 API key.
# Get one for free from your TMDB account settings.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Default region (ISO 3166-1) and language for "now playing" and watch providers
TMDB_REGION=SA
TMDB_LANGUAGE=ar-SA

# Optional: OMDb API key for the numeric IMDb rating (free: https://www.omdbapi.com/apikey.aspx)
# Without it the app still shows an "open on IMDb" link.
OMDB_API_KEY=
